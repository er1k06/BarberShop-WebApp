
@{  
    ViewData["Title"] = "Appointment";
}

@*CSS of the page start*@
<style>
    .appointment-form {
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-width: 350px;
        margin: 30px auto;
    }

        .appointment-form input {
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 16px;
        }

        .appointment-form button {
            padding: 12px;
            border: none;
            border-radius: 8px;
            background-color: #222;
            color: white;
            cursor: pointer;
        }
    .homeandbarber-button {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 30px;
        margin-bottom: 20px;
    }
        .btn-red{
        padding: 10px 20px;
        cursor: pointer;
    }
.btn-red{
        background-color: #9b0000;
        border: 2px solid #9b0000;
        color: white;
        padding: 13px 30px;
        font-weight: 600;
        border-radius: 5px;
        text-decoration: none;
        display: inline-block;
        margin: 5px;
        transition: 0.3s;
    }
    .btn-red:hover{
            background-color: #c00000;
            border-color: #c00000;
            color: white;
            transform: translateY(-2px);
    }

    .appointment-container {
        max-width: 500px;
        margin: 40px auto;
        padding: 30px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
    }

        .appointment-container h2 {
            text-align: center;
            margin-bottom: 10px;
        }

        .appointment-container p {
            text-align: center;
            color: #666;
            margin-bottom: 25px;
        }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 18px;
    }

        .form-group input {
            width: 100%;
            box-sizing: border-box;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 16px;
        }

    .submit-btn {
        width: 100%;
        padding: 13px;
        background: #222;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        cursor: pointer;
    }

        .submit-btn:hover {
            background: #444;
        }
    </style>
@*CSS of the page end*@


@*Appointment form start*@
        <div class="appointment-container">
            <h2>Create an Appointment</h2>

            <form asp-controller="Barber"
                  asp-action="Create"
                  method="post">

                <div class="form-group">
                    <label for="AppointmentDate">Date And Time</label>
                    <input type="datetime-local"
                           id="AppointmentDate"
                           name="AppointmentDate"
                           required />
                </div>

                <div class="form-group">
                    <label for="FirstName">First Name</label>
                    <input type="text"
                           id="FirstName"
                           name="FirstName"
                           placeholder="Enter First Name"
                           required />
                </div>

                <div class="form-group">
                    <label for="LastName">Last Name</label>
                    <input type="text"
                           id="LastName"
                           name="LastName"
                           placeholder="Enter Last Name"
                           required />
                </div>

                <div class="form-group">
                    <label for="PhoneNumber">Телефонен номер</label>
                    <input type="tel"
                           id="PhoneNumber"
                           name="PhoneNumber"
                           placeholder="+359..."
                           required/>
                </div>

                <button type="submit" class="submit-btn">
                Create an Appointment
                </button>
            </form>
        </div>
@*Appointment form end*@
    

@*Barbers and Home buttons start*@
<div class="homeandbarber-button">
    <a asp-controller="Barber"
       asp-action="Index"
       class="btn-red">
        Back to Barbers
    </a>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn-red">
        Back to Home
    </a>
</div>
@*Barbers and Home buttons end*@