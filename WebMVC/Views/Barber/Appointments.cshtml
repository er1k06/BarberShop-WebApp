@model WebMVC.Data.Models.Barber
@{  
    ViewData["Title"] = "Appointment";
}

@*CSS of the page start*@
<style>
   

    .appointment-form {
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-width: 350px;
        margin: 30px auto;
    }

        .appointment-form input {
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 16px;
        }

        .appointment-form button {
            padding: 12px;
            border: none;
            border-radius: 8px;
            background-color: #222;
            color: white;
            cursor: pointer;
        }
    .homeandbarber-button {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 30px;
        margin-bottom: 20px;
    }
        .btn-red{
        padding: 10px 20px;
        cursor: pointer;
    }
    .appointment-container {
        max-width: 500px;
        margin: 40px auto;
        padding: 30px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
    }

        .appointment-container h2 {
            text-align: center;
            margin-bottom: 10px;
        }

        .appointment-container p {
            text-align: center;
            color: #666;
            margin-bottom: 25px;
        }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 18px;
    }

        .form-group input {
            width: 100%;
            box-sizing: border-box;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 16px;
        }

    .submit-btn {
        width: 100%;
        padding: 13px;
        background: #222;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        cursor: pointer;
    }

        .submit-btn:hover {
            background: #444;
        }

    .appointment-container {
        max-width: 500px;
        margin: 40px auto;
        padding: 25px;
        background-color: #222;
        color: white;
        border-radius: 10px;
    }

        .appointment-container input {
            width: 100%;
            padding: 10px;
            margin: 8px 0 15px;
            box-sizing: border-box;
            border: 1px solid #555;
            border-radius: 5px;
        }

        .appointment-container button {
            width: 100%;
            padding: 10px;
            background-color: #d62828;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

            .appointment-container button:hover {
                background-color: #a91e1e;
            }

    </style>
@*CSS of the page end*@


@*Appointment form start*@
        <div class="appointment-container">
            <h2>Create an Appointment</h2>
<form asp-controller="Barber"
      asp-action="Appointment"
      asp-route-id="@Model.Id"
      method="post">

    @Html.AntiForgeryToken()

    <label>First Name</label>
    <input type="text" name="FirstName" required />

    <label>Last Name</label>
    <input type="text" name="LastName" required />

    <label>Phone Number</label>
    <input type="tel" name="PhoneNumber" required />

    <label>Appointment Date</label>
    <input type="datetime-local"
           name="AppointmentDate"
           required />

    <button type="submit">Book Appointment</button>
</form>
        </div>
@*Appointment form end*@
    

@*Barbers and Home buttons start*@
<div class="homeandbarber-button">
    <a asp-controller="Barber"
       asp-action="Index"
       class="btn-red">
        Back to Barbers
    </a>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn-red">
        Back to Home
    </a>
</div>

@*Barbers and Home buttons end*@