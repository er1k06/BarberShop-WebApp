@model IEnumerable<WebMVC.Data.Models.Barber>

@{
    ViewData["Title"] = "Our Barbers";

    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;

}

<style>
    .barbers-page {
        padding: 40px 0 70px;
    }

    .barbers-header {
        text-align: center;
        margin-bottom: 45px;
    }

        .barbers-header h1 {
            font-size: 3rem;
            font-weight: 700;
            color: #f5f5f5;
            letter-spacing: 2px;
        }

        .barbers-header p {
            color: #999;
            font-size: 1.1rem;
        }

    .barber-card {
        background-color: #1c1c1c;
        border: 1px solid #2d2d2d;
        border-radius: 12px;
        overflow: hidden;
        height: 100%;
        transition: 0.3s;
    }

        .barber-card:hover {
            transform: translateY(-7px);
            border-color: #b00000;
            box-shadow: 0 10px 30px rgba(0,0,0,0.35);
        }

    .barber-image {
        width: 100%;
        height: 320px;
        object-fit: cover;
        display: block;
    }

    .barber-info {
        padding: 25px;
    }

    .barber-name {
        font-size: 1.5rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 15px;
    }

    .barber-detail {
        color: #aaaaaa;
        margin-bottom: 8px;
    }

        .barber-detail strong {
            color: #ffffff;
        }

    .shop-name {
        color: #b00000;
        font-weight: 600;
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15px;
        margin-top: 50px;
    }

    .page-button {
        padding: 10px 22px;
        border-radius: 5px;
        border: 1px solid #444;
        background-color: #1c1c1c;
        color: white;
        text-decoration: none;
        transition: 0.3s;
    }

        .page-button:hover {
            background-color: #b00000;
            border-color: #b00000;
            color: white;
        }

        .page-button.disabled {
            opacity: 0.35;
            pointer-events: none;
        }

    .page-number {
        color: #aaa;
    }
</style>

<div class="container barbers-page">

    <div class="barbers-header">

        <h1>Our Barbers</h1>

        <p>
            Meet the professionals behind the Blend House experience.
        </p>

    </div>


    <div class="row g-4">

        @foreach (var barber in Model)
        {
            <div class="col-md-6 col-lg-3">

                <div class="barber-card">

                    @if (!string.IsNullOrEmpty(barber.ImageUrl))
                    {
                        <img src="@barber.ImageUrl"
                             alt="@barber.FirstName @barber.LastName"
                             class="barber-image" />
                    }
                    else
                    {
                        <img src="@barber.ImageUrl"
                             alt="@barber.FirstName @barber.LastName"
                             class="barber-image" />
                    }


                    <div class="barber-info">

                        <h2 class="barber-name">
                            @barber.FirstName @barber.LastName
                        </h2>

                        <div class="barber-detail">
                            <strong>Experience:</strong>
                            @barber.Experience years
                            <strong>Age:</strong>
                            @barber.Age years

                        </div>

                        <div class="barber-detail">
                            <strong>Works at:</strong>
                            <span class="shop-name">
                                @barber.Shop?.Name
                            </span>
                        </div>

                    </div>

                </div>

            </div>
        }

    </div>


    @if (totalPages > 1)
    {
        <div class="pagination-container">

            <a asp-controller="Barber"
               asp-action="Index"
               asp-route-page="@(currentPage - 1)"
               class="page-button @(currentPage == 1 ? "disabled" : "")">
                ← Previous
            </a>


            <span class="page-number">
                Page @currentPage of @totalPages
            </span>


            <a asp-controller="Barber"
               asp-action="Index"
               asp-route-page="@(currentPage + 1)"
               class="page-button @(currentPage == totalPages ? "disabled" : "")">
                Next →
            </a>

        </div>
    }

</div>