@{
    ViewData["Title"] = "Home";
}

<style>
    .hero-section {
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: white;
        position: relative;
        overflow: hidden;
        border-radius: 0 0 20px 20px;
        background: linear-gradient(rgba(0, 0, 0, 0.70), rgba(0, 0, 0, 0.70)), url("https://images.unsplash.com/photo-1621605815971-fbc98d665033?auto=format&fit=crop&w=1800&q=85");
        background-size: cover;
        background-position: center;
    }

    .hero-content {
        max-width: 850px;
        padding: 40px 20px;
    }

    .hero-subtitle {
        color: #c00000;
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: 4px;
        text-transform: uppercase;
        margin-bottom: 15px;
    }

    .hero-title {
        font-size: 4.5rem;
        font-weight: 800;
        letter-spacing: 3px;
        margin-bottom: 20px;
    }

    .hero-description {
        font-size: 1.2rem;
        color: #dddddd;
        max-width: 650px;
        margin: 0 auto 35px;
        line-height: 1.7;
    }

    .btn-red {
        background-color: #9b0000;
        border: 2px solid #9b0000;
        color: white;
        padding: 13px 30px;
        font-weight: 600;
        border-radius: 5px;
        text-decoration: none;
        display: inline-block;
        margin: 5px;
        transition: 0.3s;
    }

        .btn-red:hover {
            background-color: #c00000;
            border-color: #c00000;
            color: white;
            transform: translateY(-2px);
        }

    .btn-outline-light-custom {
        background-color: transparent;
        border: 2px solid white;
        color: white;
        padding: 13px 30px;
        font-weight: 600;
        border-radius: 5px;
        text-decoration: none;
        display: inline-block;
        margin: 5px;
        transition: 0.3s;
    }

        .btn-outline-light-custom:hover {
            background-color: white;
            color: black;
            transform: translateY(-2px);
        }

    .section {
        padding: 70px 20px;
    }

    .section-title {
        text-align: center;
        font-size: 2.4rem;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .section-subtitle {
        text-align: center;
        color: #777;
        margin-bottom: 45px;
    }

    .service-card {
        border: none;
        border-radius: 12px;
        padding: 35px 25px;
        height: 100%;
        text-align: center;
        box-shadow: 0 5px 25px rgba(0,0,0,0.08);
        transition: 0.3s;
        background-color: white;
    }

        .service-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }

    .service-icon {
        font-size: 2.5rem;
        margin-bottom: 20px;
    }

    .service-card h3 {
        font-size: 1.35rem;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .service-card p {
        color: #777;
        line-height: 1.6;
    }

    .about-section {
        background-color: #111;
        color: white;
        padding: 70px 20px;
        border-radius: 15px;
    }

        .about-section p {
            color: #cccccc;
            line-height: 1.8;
            font-size: 1.05rem;
        }

    .about-highlight {
        border-left: 4px solid #9b0000;
        padding-left: 20px;
        margin-top: 25px;
    }

    @@media (max-width: 768px) {
        .hero-title {
            font-size: 3rem;
        }

        .hero-description {
            font-size: 1rem;
        }
    }
</style>

<!-- HERO -->

<section class="hero-section">

    <div class="hero-content">

        <div class="hero-subtitle">
            Premium Barber Studio
        </div>

        <h1 class="hero-title">
            BLEND HOUSE
        </h1>

        <p class="hero-description">
            Where style meets precision.
            Professional haircuts, modern fades and classic barbering
            in a comfortable and stylish atmosphere.
        </p>

        <div>
            <a asp-controller="Barber"
               asp-action="Index"
               class="btn-red">
                Meet Our Barbers
            </a>

            <a asp-controller="Shops"
               asp-action="Index"
               class="btn-outline-light-custom">
                Find Our Shops
            </a>
        </div>

    </div>

</section>

<!-- SERVICES -->

<section class="section">

    <h2 class="section-title">
        Our Services
    </h2>

    <p class="section-subtitle">
        Everything you need to look your best.
    </p>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="service-card">

                <div class="service-icon">
                    ✂️
                </div>

                <h3>
                    Classic Haircut
                </h3>

                <p>
                    Clean, precise and professional haircut
                    tailored to your personal style.
                </p>

            </div>

        </div>


        <div class="col-md-4">

            <div class="service-card">

                <div class="service-icon">
                    💈
                </div>

                <h3>
                    Fade & Styling
                </h3>

                <p>
                    Modern fades and detailed styling performed
                    by our experienced barbers.
                </p>

            </div>

        </div>


        <div class="col-md-4">

            <div class="service-card">

                <div class="service-icon">
                    🧔
                </div>

                <h3>
                    Beard Grooming
                </h3>

                <p>
                    Professional beard trimming and shaping
                    to complete your look.
                </p>

            </div>

        </div>

    </div>

</section>

<!-- ABOUT -->

<section class="about-section">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-md-6">

                <h2 class="section-title text-start">
                    More Than Just a Haircut
                </h2>

                <p>
                    At Blend House, we believe that a haircut is
                    more than just a service. It is an experience.
                </p>

                <p>
                    Our barbers combine traditional barbering
                    techniques with modern styles to give every
                    client a look they can be confident with.
                </p>

                <div class="about-highlight">

                    <strong>
                        Precision. Style. Confidence.
                    </strong>

                    <p class="mb-0 mt-2">
                        That's the Blend House standard.
                    </p>

                </div>

            </div>


            <div class="col-md-6 text-center mt-4 mt-md-0">

                <h3 class="display-5 fw-bold">
                    BLEND HOUSE
                </h3>

                <p class="mt-3">
                    Professional barbering<br />
                    Modern style<br />
                    Premium experience
                </p>

            </div>

        </div>

    </div>

</section>

<!-- CALL TO ACTION -->

<section class="section text-center">

    <h2 class="section-title">
        Ready for Your Next Look?
    </h2>

    <p class="section-subtitle">
        Choose your barber and visit one of our studios.
    </p>

    <a asp-controller="Barber"
       asp-action="Index"
       class="btn-red">
        View Our Barbers
    </a>

</section>