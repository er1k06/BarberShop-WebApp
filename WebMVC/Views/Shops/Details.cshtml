@model WebMVC.Data.Models.Shops


@{
    var barbers =
        ViewBag.Barbers as IEnumerable<WebMVC.Data.Models.Barber>;
}


@if (barbers != null && barbers.Any())
{
    <div class="row g-4">
        @foreach (var barber in barbers)
        {
            <div class="col-md-6 col-lg-3">

                <div class="barber-card">

                    @if (!string.IsNullOrEmpty(barber.ImageUrl))
                    {
                        <img src="@barber.ImageUrl"
                             alt="@barber.FirstName @barber.LastName"
                             class="barber-image" />
                    }
                    else
                    {
                        <img src="@barber.ImageUrl"
                             alt="@barber.FirstName @barber.LastName"
                             class="barber-image" />
                    }

                    @*Barber's card*@
                    <div class="barber-info">

                        <h2 class="barber-name">
                            @barber.FirstName @barber.LastName
                        </h2>

                        <div class="barber-detail">
                            <strong>Experience:</strong>
                            @barber.Experience years
                            <strong>Age:</strong>
                            @barber.Age years

                        </div>

                        <div class="barber-detail">
                            <strong>Works at:</strong>
                            <span class="shop-name">
                                @barber.Shop?.Name
                            </span>
                        </div>

                        @*Appointments button*@
                        <a asp-controller="Barber"
                           asp-action="appointments"
                           asp-route-id="@barber.Id"
                           class="btn-red">
                            Create Appointment
                        </a>

                    </div>

                </div>

            </div>
        }
    </div>
}
else
{
    <p>There are no barbers assigned to this shop.</p> /*This error shows if the Barber Shop have no active barbers working in it*/
}