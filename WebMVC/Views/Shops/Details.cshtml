@model WebMVC.Data.Models.Shops
@{
    var barbers =
        ViewBag.Barbers as IEnumerable<WebMVC.Data.Models.Barber>;
}


@*CSS of page start*@
<style>
    .barber-card {
        background-color: #1c1c1c;
        border: 1px solid #2d2d2d;
        border-radius: 12px;
        overflow: hidden;
        height: 100%;
        transition: 0.3s;
    }

        .barber-card:hover {
            transform: translateY(-7px);
            border-color: #b00000;
            box-shadow: 0 10px 30px rgba(0,0,0,0.35);
        }

    .barber-image {
        width: 100%;
        height: 320px;
        object-fit: cover;
        display: block;
    }

    .barber-info {
        padding: 25px;
    }

    .barber-name {
        font-size: 1.5rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 15px;
    }

    .barber-detail {
        color: #aaaaaa;
        margin-bottom: 8px;
    }

        .barber-detail strong {
            color: #ffffff;
        }
</style>
@*CSS of page end*@


@if (barbers != null && barbers.Any())
{
    <div class="row g-4">
        @foreach (var barber in barbers)
        {
            <div class="col-md-6 col-lg-3">

                <div class="barber-card">

                    @if (!string.IsNullOrEmpty(barber.ImageUrl))
                    {
                        <img src="@barber.ImageUrl"
                             alt="@barber.FirstName @barber.LastName"
                             class="barber-image" />
                    }
                    else
                    {
                        <img src="@barber.ImageUrl"
                             alt="@barber.FirstName @barber.LastName"
                             class="barber-image" />
                    }


                    <div class="barber-info">

                        <h2 class="barber-name">
                            @barber.FirstName @barber.LastName
                        </h2>

                        <div class="barber-detail">
                            <strong>Experience:</strong>
                            @barber.Experience years
                            <strong>Age:</strong>
                            @barber.Age years

                        </div>

                        <div class="barber-detail">
                            <strong>Works at:</strong>
                            <span class="shop-name">
                                @barber.Shop?.Name
                            </span>
                        </div>
                        <a asp-controller="Barber"
                           asp-action="appointments"
                           asp-route-id="@barber.Id"
                           class="btn btn-primary">
                            Create Appointment
                        </a>

                    </div>

                </div>

            </div>
        }
    </div>
}
else
{
    <p>There are no barbers assigned to this shop.</p>
}